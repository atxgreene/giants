; Engine configuration file.
; THE WATCHERS: FALL OF THE GIANTS — vertical slice prototype.
; All gameplay scenes are constructed in code; main.tscn is the only scene file.

config_version=5

[application]

config/name="The Watchers: Fall of the Giants"
config/description="Isometric action-roguelike vertical slice. You are the Appointed Witness, sent against the fallen Watchers and the spirits of the giants."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

DataDB="*res://scripts/core/data_db.gd"
Assets="*res://scripts/core/asset_registry.gd"
SaveMan="*res://scripts/save/save_manager.gd"
AudioMan="*res://scripts/core/audio_manager.gd"
FX="*res://scripts/core/fx.gd"
Game="*res://scripts/core/game_manager.gd"
RunState="*res://scripts/core/run_manager.gd"
CodexMan="*res://scripts/codex/codex_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.06, 1)
viewport/hdr_2d=true
